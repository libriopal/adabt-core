  "productionPolishDoctrine": {
    "sourceDirective": "Polished replayable competitive multiplayer puzzle game with human-in-the-loop iteration before content scaling.",
    "visualTruthRule": "A token is production-ready only when it improves immediate understanding, feedback clarity, balanced difficulty communication, or meaningful choice readability.",
    "humanGate": {
      "requiredBeforeScalingContent": true,
      "minimumPlaytestSessionsPerMilestone": 5,
      "approvalRoles": ["design_director", "art_director", "audio_director", "multiplayer_design", "qa_balance"],
      "failureRule": "If players do not understand the objective without explanation, the visual language fails regardless of technical completeness."
    },
    "loopQualityTargets": {
      "immediateUnderstanding": "Objective, legal action, blocked action, reward preview, and teammate dependency are visible within the first 3 seconds.",
      "clearFeedbackJuice": "Every accepted input produces visual, audio, haptic-ready, numeric, and state-change confirmation within one frame plus presentation latency.",
      "balancedDifficulty": "Difficulty indicators expose pressure without hiding solvability or creating frustration spikes.",
      "meaningfulChoices": "UI distinguishes strategic options, risk, role contribution, and replay modifiers without extra clicks."
    }
  },
