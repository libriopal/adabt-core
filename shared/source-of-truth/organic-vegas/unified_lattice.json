  "productionState": {
    "currentArtifactState": "r0 baseline existed with 20 genre modules, 312-byte state overhead, deterministic replay, and performance budgets.",
    "r1Directive": "Enforce a human-in-the-loop production pipeline for a polished, replayable, competitive multiplayer puzzle game before scaling content.",
    "hardBlocks": [
      "Do not scale to 50+ stages before one final-quality vertical slice passes human review.",
      "Do not treat adaptive AI as permission to change ranked-match rules during play.",
      "Do not accept co-op levels that are only larger solo boards.",
      "Do not ship stages that fail softlock, unintended shortcut, or unnecessary input review."
    ]
  },
  "productionPipeline": [
    {
      "id": "discovery_preproduction",
      "weeks": "1-4",
      "outputs": ["hook", "targetAudience", "coreLoop", "monetizationModel", "gdd", "highFidelityWireframes"],
      "humanGate": "Reviewers can explain goal, primary action, reward, and multiplayer promise without developer coaching.",
      "unlocks": ["prototype_technical_spike"]
    },
    {
      "id": "prototype_technical_spike",
      "weeks": "5-8",
      "outputs": ["playableNoArtPrototype", "coreMechanicFunReport", "inputLatencyProbe", "softlockProbe"],
      "humanGate": "Players voluntarily replay the matching/sliding core before final art, economy, or content volume is added.",
      "unlocks": ["vertical_slice"]
    },
    {
      "id": "vertical_slice",
      "phase": "production_phase_1",
      "outputs": ["oneFinalQualityLevel", "finalArtPass", "finalSoundPass", "finalUiPass", "multiplayerSyncPass"],
      "humanGate": "Director signs the shippable quality bar and placeholder UX is removed.",
      "unlocks": ["content_systems"]
    },
    {
      "id": "content_systems",
      "phase": "production_phase_2",
      "outputs": ["50PlusStages", "backendMultiplayer", "leaderboards", "economySystems", "stageTemplateLibrary"],
      "humanGate": "Each stage archetype has a distinct strategy and passes QA gates.",
      "unlocks": ["iterative_qa_balancing"]
    },
    {
      "id": "iterative_qa_balancing",
      "phase": "testing",
      "outputs": ["softlockReport", "shortcutReport", "difficultyCurveReport", "frustrationBoredomReport"],
      "humanGate": "Playtesters report intellectual pressure without arbitrary frustration.",
      "unlocks": ["prelaunch_liveops_setup"]
    },
    {
      "id": "prelaunch_liveops_setup",
      "phase": "release_candidate",
      "outputs": ["analyticsPlan", "monetizationSdkPlan", "serverScalingPlan", "matchmakingPolicy", "competitiveSeasonPolicy"],
      "humanGate": "Launch review finds no blocking telemetry, economy, scale, or ranked-fairness unknowns.",
      "unlocks": ["launch_postlaunch"]
    },
    {
      "id": "launch_postlaunch",
      "phase": "live",
      "outputs": ["liveOpsCalendar", "balancePatchPolicy", "communityEngagementLoop", "seasonTelemetryReview"],
      "humanGate": "Live tuning remains bounded by the source-of-truth mechanics and competitive integrity rules.",
      "unlocks": []
    }
  ],
  "loopQualityGates": {
    "immediateUnderstanding": {
      "weight": 1.0,
      "machinePredicate": "firstPlayableFrame.includes(objective,validInput,blockedInput,rewardPreview)",
      "humanPredicate": "newTesterStatesGoalWithinSeconds<=3",
      "failureAction": "redesign objective rail, affordances, or level intro"
    },
    "clearFeedbackJuice": {
      "weight": 1.0,
      "machinePredicate": "acceptedInput.feedbackFrameDelta<=1",
      "humanPredicate": "testerDescribesActionsAsResponsiveAndSatisfying",
      "failureAction": "repair visual/audio/numeric/haptic-ready feedback before adding content"
    },
    "balancedDifficulty": {
      "weight": 1.0,
      "machinePredicate": "difficultyDeltaWithinBounds && noHiddenRuleMutation",
      "humanPredicate": "testerReportsPressureWithoutHelplessness",
      "failureAction": "retune objectives, hints, board generation, or adaptive bounds"
    },
    "meaningfulChoices": {
      "weight": 1.0,
      "machinePredicate": "viableStrategyCount>=2",
      "humanPredicate": "testerCanNameAtLeastTwoStrategies",
      "failureAction": "add strategic role, risk, reward, or board variation"
    }
  },
  "multiplayerPuzzleRules": {
    "snappyControls": {
      "inputModes": ["tap", "drag"],
      "unnecessaryInputBudget": 0,
      "inputToFeedbackFrameBudget": 1
    },
    "sharedStruggle": {
      "required": true,
      "acceptedForms": ["asymmetricRoles", "timingDependency", "spatialDependency", "resourceTradeoff"],
      "rejectedForms": ["sameSoloBoardButLarger", "parallelSoloPlayOnly"]
    },
    "unintendedSolutionCheck": {
      "requiredBeforeStageApproval": true,
      "methods": ["solverSearch", "humanExploitReview", "telemetryAfterLaunch"],
      "patchPolicy": "preserve legitimate wins, patch degenerate repeatability"
    },
    "highSpeedAnimationSync": {
      "source": "acceptedEventLog",
      "animationRule": "remote animation is deterministic presentation, not authority",
      "desyncTolerance": "zero after rollback_repair"
    },
    "competitiveIntegrity": {
      "authoritativeRank": true,
      "leaderboardUpdateHook": "post_bank",
      "matchmakingInputs": ["skillBand", "latencyBand", "rolePreference", "recentDisconnectRisk"],
      "antiExploitChecks": ["stalling", "disconnectAbuse", "scoreDuplication", "collusion"]
    }
  },
