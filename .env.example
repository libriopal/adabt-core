# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Data (SQLite) ───────────────────────────────────────
# Directory where the SQLite database is stored.
# On Railway, mount a Volume at this path for persistence across deploys.
DATA_DIR=/data

# ── Workers (require Redis) ─────────────────────────────
# Set to "false" to disable BullMQ background workers
ENABLE_WORKERS=false

# Only needed if ENABLE_WORKERS is not "false"
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
