{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/choas12/api-request-envelope.schema.json",
  "title": "API Request Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase_id",
    "task_id",
    "agent_role",
    "model",
    "prompt_hash",
    "request_purpose",
    "allowed_tool_scope",
    "mutation_intent",
    "deployment_impact",
    "memory_impact",
    "risk_level",
    "approval_state",
    "messages"
  ],
  "properties": {
    "phase_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "agent_role": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "prompt_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "request_purpose": { "type": "string", "minLength": 1 },
    "allowed_tool_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "mutation_intent": {
      "type": "string",
      "enum": ["none", "local_files", "branch_push", "deployment", "external_system"]
    },
    "deployment_impact": {
      "type": "string",
      "enum": ["none", "readiness_only", "may_change_runtime", "deploy"]
    },
    "memory_impact": {
      "type": "string",
      "enum": ["none", "local_ledger_only", "durable_memory_candidate"]
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "approval_state": {
      "type": "string",
      "enum": ["DRAFT", "PENDING_AUDIT", "VETO", "REPAIR_REQUIRED", "PASS", "GENERATE_AUTHORIZED"]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string" },
          "content": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
