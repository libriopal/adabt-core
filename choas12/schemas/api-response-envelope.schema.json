{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/choas12/api-response-envelope.schema.json",
  "title": "API Response Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_id", "phase_id", "task_id", "agent_role", "model", "status", "approval_state"],
  "properties": {
    "audit_id": { "type": "string", "minLength": 1 },
    "phase_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "agent_role": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["dry_run", "dispatched", "rejected", "error"] },
    "approval_state": { "type": "string" },
    "response_preview": { "type": "string" },
    "error": { "type": "string" }
  }
}
