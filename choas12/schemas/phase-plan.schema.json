{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/choas12/phase-plan.schema.json",
  "title": "Phase Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["phase_id", "status", "objective", "required_outputs", "mutation_policy", "acceptance"],
  "properties": {
    "phase_id": { "type": "string" },
    "status": { "type": "string" },
    "objective": { "type": "string" },
    "required_outputs": {
      "type": "object",
      "additionalProperties": true
    },
    "api_requests": {
      "type": "object",
      "additionalProperties": true
    },
    "mutation_policy": {
      "type": "object",
      "required": ["may_write_files", "may_push_branch", "may_deploy", "may_mark_complete"],
      "properties": {
        "may_write_files": { "type": "boolean" },
        "may_push_branch": { "type": "boolean" },
        "may_deploy": { "type": "boolean" },
        "may_mark_complete": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
