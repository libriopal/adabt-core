{
  "name": "agros-struthio-runtime",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --prefix apps/frontend && npm run build --prefix apps/backend",
    "test": "npm test --prefix apps/backend",
    "migrate": "npm run migrate --prefix apps/backend",
    "validate": "node scripts/validate-production.mjs",
    "validate:phase0": "node scripts/validate-phase0.mjs",
    "validate:phase1": "node scripts/validate-phase1.mjs",
    "validate:phase2": "node scripts/validate-phase2.mjs",
    "validate:phase3": "node scripts/validate-phase3.mjs",
    "validate:phase4": "node scripts/validate-phase4.mjs",
    "validate:phase5": "node scripts/validate-phase5.mjs",
    "validate:phase6": "node scripts/validate-phase6.mjs",
    "validate:phase7": "node scripts/validate-phase7.mjs",
    "validate:phase8": "node scripts/validate-phase8.mjs",
    "validate:phase9": "node scripts/validate-phase9.mjs",
    "validate:phase10": "node scripts/validate-phase10.mjs",
    "validate:phase11": "node scripts/validate-phase11.mjs",
    "validate:phase12": "node scripts/validate-phase12.mjs",
    "validate:phase13": "node scripts/validate-phase13.mjs",
    "validate:phase14": "node scripts/validate-phase14.mjs",
    "artifact:release-evidence": "node scripts/generate-release-evidence-artifact.mjs",
    "artifact:release-bundle": "node scripts/generate-release-bundle-summary.mjs",
    "artifact:promotion-timeline": "node scripts/export-release-promotion-timeline.mjs",
    "artifact:rollback-timeline": "node scripts/export-release-rollback-timeline.mjs",
    "artifact:evidence-manifest": "node scripts/generate-release-evidence-manifest.mjs",
    "release:ci-check": "node scripts/attach-release-ci-check.mjs",
    "release:rollback-ci-check": "node scripts/attach-release-rollback-ci-check.mjs",
    "release:verify-artifacts": "node scripts/verify-release-artifacts.mjs",
    "preflight:release": "node scripts/release-preflight.mjs",
    "preflight:railway": "node scripts/release-preflight.mjs --provider=railway",
    "preflight:render": "node scripts/release-preflight.mjs --provider=render",
    "preflight:docker": "node scripts/release-preflight.mjs --provider=local-docker",
    "dev:frontend": "npm run dev --prefix apps/frontend",
    "dev:backend": "npm run dev --prefix apps/backend"
  }
}
