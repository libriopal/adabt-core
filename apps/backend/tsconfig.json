{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": false,
    "baseUrl": ".",
    "paths": {
      "@match3d/farkle-shared": ["../../packages/farkle-shared/src/types-bridge.ts"],
      "@match3d/farkle-engine": ["../../packages/farkle-engine/src/index.ts"]
    }
  },
  "references": [
    { "path": "../../packages/farkle-shared" },
    { "path": "../../packages/farkle-engine" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "src/scripts"]
}
