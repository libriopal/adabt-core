{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@match3d/farkle-engine": ["../../packages/farkle-engine/src/index.ts"],
      "@match3d/farkle-shared": ["../../packages/farkle-shared/src/index.ts"],
      "@match3d/game-core": ["../../packages/game-core/src/index.ts"],
      "zustand": ["./node_modules/zustand/index.d.ts"],
      "zustand/middleware": ["./node_modules/zustand/middleware.d.ts"],
      "@dimforge/rapier3d-compat": ["./node_modules/@dimforge/rapier3d-compat/rapier.d.ts"],
      "eventemitter3": ["./node_modules/eventemitter3/index.d.ts"],
      "uuid": ["./node_modules/uuid/dist/index.d.ts"],
      "nanoid": ["./node_modules/nanoid/index.d.ts"]
    }
  },
  "include": ["src"]
}
